<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!-- Microsoft.Data.SqlClient requires TrustServerCertificate=true (or a real cert)
         against local SQLEXPRESS since defaults flipped to encrypted in v4.0+. -->
    <add name="rzsql"
         providerName="Microsoft.Data.SqlClient"
         connectionString="Data Source=.\SQLEXPRESS;Integrated Security=SSPI;Initial Catalog=RZSQLFileSystem;MultipleActiveResultSets=true;TrustServerCertificate=true" />
  </connectionStrings>
</configuration>
