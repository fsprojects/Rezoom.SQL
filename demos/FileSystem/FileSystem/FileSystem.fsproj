<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FileSystem</RootNamespace>
    <AssemblyName>FileSystem</AssemblyName>
    <IsPackable>false</IsPackable>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AssemblyInfo.fs" />
    <Compile Include="Common.fs" />
    <Compile Include="DemoSetup.fs" />
    <Compile Include="Persistence.fsi" />
    <Compile Include="Persistence.fs" />
    <Compile Include="Domain.fsi" />
    <Compile Include="Domain.fs" />
    <Compile Include="Execution.fs" />
    <Compile Include="Program.fs" />
    <None Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="V1.model.sql" />
    <EmbeddedResource Include="rzsql.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="8.0.401" />
    <PackageReference Include="Rezoom" Version="1.4.0" />
    <!-- Wrapper meta-package: brings in Rezoom.SQL.Provider, Compiler, Mapping, and
         Microsoft.Data.SqlClient as the TSQL runtime driver. -->
    <PackageReference Include="Rezoom.SQL.Provider.TSQL" Version="$(RezoomSqlPkgVersion)" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
  </ItemGroup>

</Project>
