<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SQLFiddle.Website</RootNamespace>
    <AssemblyName>SQLFiddle.Website</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="8.0.10" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- Legacy ASP.NET 4.5 files preserved on disk for reference but excluded from
       compilation/content. Safe to delete once the port is validated. -->
  <ItemGroup>
    <Compile Remove="App_Start\**" />
    <Compile Remove="Global.asax.cs" />
    <Compile Remove="Controllers\HomeController.cs" />
    <Compile Remove="Properties\AssemblyInfo.cs" />
    <None Remove="Global.asax" />
    <None Remove="Web.config" />
    <None Remove="Web.Debug.config" />
    <None Remove="Web.Release.config" />
    <None Remove="packages.config" />
    <Content Remove="Scripts\**" />
    <Content Remove="Content\**" />
    <Content Remove="Views\**" />
    <None Remove="Scripts\**" />
    <None Remove="Content\**" />
    <None Remove="Views\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SQLFiddle\SQLFiddle.fsproj" />
  </ItemGroup>

</Project>
