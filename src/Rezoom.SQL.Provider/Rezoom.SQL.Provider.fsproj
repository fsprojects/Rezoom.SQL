<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Type providers must be loaded by the F# compiler / IDE tooling at design time.
         netstandard2.0 maximizes host compatibility (modern fsc loads ns2.0 providers fine). -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <Version>0.5.0</Version>
    <Authors>Robert Peele</Authors>
    <Description>F# type provider for Rezoom.SQL.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/rspeele/Rezoom.SQL</PackageProjectUrl>
    <RepositoryUrl>https://github.com/rspeele/Rezoom.SQL</RepositoryUrl>
    <PackageReleaseNotes>Modernize: bump FSharp.Core; track modernized Rezoom.SQL.Compiler / Mapping.</PackageReleaseNotes>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <!-- Type provider packaging: the design-time assembly and ALL its transitive
         dependencies must live together under typeproviders/fsharp41/{tfm}/ so that the
         F# compiler can load them as a self-contained set. Nothing belongs in lib/. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <SuppressDependenciesWhenPacking>false</SuppressDependenciesWhenPacking>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackTypeProviderDesignTimeAssemblies</TargetsForTfmSpecificContentInPackage>
    <!-- NU5128: no lib/ folder for the target framework — intentional for a TP. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <Target Name="PackTypeProviderDesignTimeAssemblies">
    <ItemGroup>
      <!-- The provider itself, plus everything copied next to it at build time
           (Compiler, Mapping, FParsec*, FParsec-Pipes, LicenseToCIL, Rezoom, FSharp.Core, ...). -->
      <TfmSpecificPackageFile Include="$(OutputPath)$(AssemblyName).dll"
                              PackagePath="typeproviders/fsharp41/netstandard2.0/$(AssemblyName).dll" />
      <TfmSpecificPackageFile Include="@(ReferenceCopyLocalPaths->'%(FullPath)')"
                              PackagePath="typeproviders/fsharp41/netstandard2.0/%(ReferenceCopyLocalPaths.DestinationSubPath)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Compile Include="AssemblyInfo.fs" />
    <Compile Include="Watcher.fs" />
    <Compile Include="UserModelCache.fs" />
    <Compile Include="CompileTimeColumnMap.fs" />
    <None Include="ProvidedTypes-LICENSE.md" />
    <Compile Include="ProvidedTypes.fsi" />
    <Compile Include="ProvidedTypes.fs" />
    <Compile Include="DocStrings.fs" />
    <Compile Include="TypeGeneration.fs" />
    <Compile Include="AssemblyResolver.fs" />
    <Compile Include="Provider.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="8.0.401" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rezoom.SQL.Compiler\Rezoom.SQL.Compiler.fsproj" />
    <ProjectReference Include="..\Rezoom.SQL.Mapping\Rezoom.SQL.Mapping.fsproj" />
  </ItemGroup>

</Project>
