<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- TP smoke tests: build against the published Rezoom.SQL.Provider nupkg and
         exercise live SQLite via Microsoft.Data.Sqlite. Discoverable by `dotnet test`. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AssemblyInfo.fs" />
    <Compile Include="Shared.fs" />
    <Compile Include="TestSelects.fs" />
    <Compile Include="TestRowTypeInterfaces.fs" />
    <Compile Include="TestPickles.fs" />
    <Compile Include="TestMigrateConnectionString.fs" />
    <Compile Include="Program.fs" />
    <None Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="V1.model.sql" />
    <EmbeddedResource Include="rzsql.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="8.0.401" />
    <PackageReference Include="Rezoom" Version="2.0.0" />
    <!-- Wrapper meta-package: brings in Rezoom.SQL.Provider, Compiler, Mapping, and
         Microsoft.Data.Sqlite as the SQLite runtime driver. -->
    <PackageReference Include="Rezoom.SQL.Provider.SQLite" Version="$(RezoomSqlPkgVersion)" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="FsPickler" Version="5.3.2" />
    <!-- Pinning to NUnit 3.x to match Rezoom.SQL.Test. -->
    <PackageReference Include="FsUnit" Version="5.6.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TypeProviderUser.UserTypes\TypeProviderUser.UserTypes.fsproj" />
    <ProjectReference Include="..\TypeProviderUser.BclOnlyTypes\TypeProviderUser.BclOnlyTypes.fsproj" />
  </ItemGroup>

</Project>
